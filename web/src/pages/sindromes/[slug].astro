---
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import '../../styles/paginas-referencia.css';
import '../../styles/sindrome-detalhe.css';
import { AvisoEstimativa } from '../../components/AvisoEstimativa';
import Cariotipo from '../../components/Cariotipo.astro';
import { CARIOTIPOS } from '../../lib/cariotipos';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const lista = (await getCollection('sindromes')).sort((a, b) => a.data.ordem - b.data.ordem);
  return lista.map((s, i) => ({
    params: { slug: s.id },
    props: { s, anterior: lista[i - 1], proxima: lista[i + 1], total: lista.length },
  }));
}
const { s, anterior, proxima, total } = Astro.props;
const { Content, headings } = await render(s);
const secoes = headings.filter((heading) => heading.depth === 2);
const cariotipo = CARIOTIPOS[s.id];
const data = new Date(s.data.atualizadoEm + 'T12:00:00').toLocaleDateString('pt-BR');
---
<Base titulo={s.data.nome} descricao={s.data.resumo} amplo>
  <article class="sindrome-detalhe">
    <div class="sindrome-caminho">
      <a href="/sindromes"><span class="seta-voltar"><Icone nome="seta" tamanho={17} /></span> Todas as síndromes</a>
      <span>GUIA {String(s.data.ordem).padStart(2, '0')} / {String(total).padStart(2, '0')}</span>
    </div>

    <header class="sindrome-abertura">
      <div>
        <p class="sobretitulo"><Icone nome="dna" tamanho={18} /> GENÉTICA EM LINGUAGEM SIMPLES</p>
        <h1>{s.data.nome}</h1>
        <div class="sindrome-atalhos">
          {secoes.length > 0 && <a href={`#${secoes[0].slug}`}>Entenda a condição <span aria-hidden="true">↓</span></a>}
          <a href="#fontes">Consultar fontes <Icone nome="livro" tamanho={16} /></a>
        </div>
      </div>
      {cariotipo && <Cariotipo cariotipo={cariotipo} />}
      <aside class="sindrome-ficha" aria-label="Informações desta página">
        <div class="sindrome-ficha__topo"><span><Icone nome="dna" tamanho={24} /></span><p>EM FOCO</p></div>
        <dl>
          <div><dt>Alteração / cariótipo</dt><dd class="sindrome-ficha__cariotipo">{s.data.cariotipo}</dd></div>
          <div><dt>Revisão do conteúdo</dt><dd><span class:list={['sindrome-revisao', { 'sindrome-revisao--concluida': s.data.revisadoPor }]}><span aria-hidden="true"></span>{s.data.revisadoPor ? 'Revisado' : 'Em revisão'}</span>{s.data.revisadoPor && <small>{s.data.revisadoPor.nome}, {s.data.revisadoPor.credencial}</small>}</dd></div>
          <div><dt>Última atualização</dt><dd><time datetime={s.data.atualizadoEm}>{data}</time></dd></div>
        </dl>
      </aside>
    </header>

    <div class="sindrome-layout">
      <nav class="sindrome-indice" aria-label="Nesta página">
        <p>NESTA PÁGINA</p>
        <ol role="list">
          {secoes.map((secao, i) => <li><a href={`#${secao.slug}`}><span>{String(i + 1).padStart(2, '0')}</span>{secao.text}</a></li>)}
          <li><a href="#fontes"><span>{String(secoes.length + 1).padStart(2, '0')}</span>Fontes para conferir</a></li>
        </ol>
      </nav>
      <div class="sindrome-leitura">
        <div class="sindrome-texto"><Content /></div>

        <section class="sindrome-fontes" id="fontes" aria-labelledby="titulo-fontes">
          <p class="sobretitulo"><Icone nome="livro" tamanho={17} /> PARA APROFUNDAR A LEITURA</p>
          <h2 id="titulo-fontes">Fontes para conferir</h2>
          <ul role="list">
            {s.data.fontes.map((fonte) => <li>{fonte.url
              ? <a href={fonte.url} rel="noopener"><span>{fonte.titulo}</span><span aria-hidden="true">↗</span></a>
              : <span>{fonte.titulo}</span>}</li>)}
          </ul>
          <a class="sindrome-metodologia" href="/metodologia">Conheça os critérios e limites do site <Icone nome="seta" tamanho={16} /></a>
        </section>
        {s.data.dependeIdadeMaterna && <AvisoEstimativa />}
      </div>
    </div>

    <nav class="sindrome-outros" aria-label="Outros guias de síndromes">
      {anterior && <a href={`/sindromes/${anterior.id}`}><span class="seta-voltar"><Icone nome="seta" tamanho={20} /></span><div><small>GUIA ANTERIOR</small><span>{anterior.data.nome}</span></div></a>}
      {proxima && <a class="sindrome-outros__proximo" href={`/sindromes/${proxima.id}`}><div><small>PRÓXIMO GUIA</small><span>{proxima.data.nome}</span></div><Icone nome="seta" tamanho={20} /></a>}
    </nav>
  </article>
</Base>
