---
import '../styles/global.css';
import Icone from '../components/Icone.astro';
interface Props { titulo: string; descricao: string; inicio?: boolean; amplo?: boolean }
const { titulo, descricao, inicio = false, amplo = false } = Astro.props;
const nomeSite = 'Genética da Gravidez Explicada';
const links = [
  { href: '/', texto: 'Início' },
  { href: '/sindromes', texto: 'Síndromes' },
  { href: '/mito-ou-verdade', texto: 'Mito ou verdade' },
  { href: '/painel-genetico', texto: 'Painel genético' },
  { href: '/metodologia', texto: 'Metodologia' },
];
const ativo = (href: string) => href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo === nomeSite ? nomeSite : `${titulo} · ${nomeSite}`}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="theme-color" content="#101814" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
    <header class="cabecalho">
      <div class="cabecalho-interno">
        <a class="marca" href="/" aria-label="Genética da Gravidez Explicada — início">
          <span class="marca-icone"><Icone nome="dna" tamanho={30} /></span>
          <span>Genética da Gravidez<small>EXPLICADA</small></span>
        </a>
        <nav class="navegacao" aria-label="Principal">
          {links.map(({ href, texto }) => <a href={href} aria-current={ativo(href) ? 'page' : undefined}>{texto}</a>)}
        </nav>
        <a href="/calculadora" class="botao botao-cabecalho" aria-current={ativo('/calculadora') ? 'page' : undefined}><Icone nome="calculadora" tamanho={17} /> Calculadora</a>
      </div>
    </header>
    <main id="conteudo" class:list={['conteudo', { 'pagina-inicial': inicio, 'pagina-ampla': amplo }]}><slot /></main>
    <footer class="rodape">
      <div class="rodape-interno">
        <a class="marca marca-rodape" href="/"><span class="marca-icone"><Icone nome="dna" /></span><span>Genética da Gravidez<small>EXPLICADA</small></span></a>
        <p>Informação para entender.<br />Conhecimento para conversar.</p>
        <div class="credito">
          <div class="credito-redes">
            <a href="https://github.com/TwoBrainCellsBrasil/genetica-na-gestacao" target="_blank" rel="noopener" aria-label="Código no GitHub"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 00-3.8 23.38c.6.12.82-.26.82-.58l-.01-2.05c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.31-5.47-1.34-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016.02 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.22.7.82.58A12 12 0 0012 .3"/></svg></a>
            <a href="https://www.linkedin.com/in/andreruperto/" target="_blank" rel="noopener" aria-label="LinkedIn de André Ruperto"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05a3.74 3.74 0 013.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 110-4.12 2.06 2.06 0 010 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77A1.75 1.75 0 000 1.73v20.54A1.75 1.75 0 001.77 24h20.45A1.76 1.76 0 0024 22.27V1.73A1.76 1.76 0 0022.22 0z"/></svg></a>
          </div>
          <span>Projeto por <a href="https://andreruperto.dev" target="_blank" rel="noopener">André Ruperto</a></span>
        </div>
      </div>
      <div class="rodape-aviso">Conteúdo educativo. Não é diagnóstico nem substitui consulta médica ou aconselhamento genético.</div>
    </footer>
  </body>
</html>
